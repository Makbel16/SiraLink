# Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
# Local Docker: postgresql://siralink:siralink_secret@localhost:5432/siralink_db
# Render: postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://siralink:siralink_secret@localhost:5432/siralink_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_siralink_ethiopia_2026_dev
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Storage Configuration
# Options: 'local' (development filesystem) or 's3' (AWS S3, Cloudflare R2, Backblaze B2)
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
# S3 Configuration (Required when UPLOAD_PROVIDER=s3)
UPLOAD_BUCKET=siralink-media
UPLOAD_REGION=auto
UPLOAD_ENDPOINT=
UPLOAD_ACCESS_KEY=
UPLOAD_SECRET_KEY=
PUBLIC_STORAGE_BASE_URL=

# AI Voice Transcription
# If missing in dev, system will use MockSpeechToTextService gracefully
OPENAI_API_KEY=

# Push Notifications (Expo Push API)
EXPO_ACCESS_TOKEN=

# SMS / OTP Provider
# In development, fixed OTP '123456' is accepted for fast local testing
SMS_PROVIDER=mock
